generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Patient {
  id            String    @id @default(cuid())
  mrn           String    @unique
  title         String?
  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  dateOfBirth   DateTime
  sex           String
  genderIdentity String?
  pronouns      String?
  photoUrl      String?

  contactJson            String
  emergencyContactsJson  String   @default("[]")

  bloodType              String   @default("UNKNOWN")
  heightCm               Float?
  weightKg               Float?
  allergiesJson          String   @default("[]")
  chronicConditionsJson  String   @default("[]")
  currentMedicationsJson String   @default("[]")
  pastSurgeriesJson      String   @default("[]")
  familyHistoryJson      String   @default("[]")
  immunizationLogJson    String   @default("[]")

  insurancePoliciesJson  String   @default("[]")
  documentsJson          String   @default("[]")
  alertsJson             String   @default("[]")
  consentJson            String

  maritalStatus     String?
  occupation        String?
  preferredLanguage String    @default("English")
  ethnicity         String?

  isVip      Boolean   @default(false)
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  portalAccount PatientAccount?

  @@index([lastName])
  @@index([isArchived])
}

model Staff {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String   @default("STAFF")
  isActive     Boolean  @default(true)

  // Profile (PRD §4.3)
  title         String?
  suffix        String?
  phone         String?
  officeLocation String?
  npi           String?
  specialtiesJson String  @default("[]")
  bio           String?
  /// Weekly working-hours template (DaySchedule[]).
  scheduleJson  String   @default("[]")

  // Account security (PRD §5.1)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime  @default(now())
  mfaEnabled          Boolean   @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credentials StaffCredential[]

  @@index([email])
}

model StaffCredential {
  id               String    @id @default(cuid())
  staffId          String
  type             String
  number           String
  issuingState     String?
  issuingAuthority String?
  issueDate        DateTime?
  expirationDate   DateTime?
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expirationDate])
}

/// Append-only record of PHI access and security events (PRD §5.1).
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  userName     String?
  userRole     String?
  action       String
  resourceType String
  resourceId   String?
  patientId    String?
  fieldName    String?
  oldValue     String?
  newValue     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model AppointmentType {
  id                     String        @id @default(cuid())
  name                   String
  defaultDurationMinutes Int           @default(30)
  bufferAfterMinutes     Int           @default(0)
  color                  String        @default("#1976D2")
  /// Fee-schedule code billed for this visit type when the encounter has no service codes.
  defaultServiceCode     String?
  /// Offered for self-scheduling in the patient portal.
  isPatientBookable      Boolean       @default(false)
  patientDescription     String?
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  appointments           Appointment[]
}

model Appointment {
  id                 String    @id @default(cuid())
  patientId          String
  providerId         String
  locationId         String    @default("main")
  appointmentTypeId  String
  slotStart          DateTime
  slotEnd            DateTime
  status             String    @default("SCHEDULED")
  reasonForVisit     String?
  notes              String?
  cancellationReason String?
  cancellationNote   String?
  recurringSeriesId  String?
  rescheduledFromId  String?
  rescheduledToId    String?
  checkedInAt        DateTime?
  completedAt        DateTime?
  remindersJson      String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id])

  @@index([patientId])
  @@index([providerId])
  @@index([slotStart])
  @@index([status])
}

model Encounter {
  id               String    @id @default(cuid())
  patientId        String
  providerId       String
  appointmentId    String?   @unique
  templateId       String?
  status           String    @default("IN_PROGRESS")
  vitalsJson       String    @default("[]")
  noteJson         String
  serviceCodesJson String    @default("[]")
  addendaJson      String    @default("[]")
  signedBy         String?
  signedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  prescriptions Prescription[]

  @@index([patientId])
  @@index([providerId])
  @@index([status])
}

model Prescription {
  id                         String   @id @default(cuid())
  encounterId                String
  patientId                  String
  prescriberId               String
  drugJson                   String
  refillsAllowed             Int      @default(0)
  refillsRemaining           Int      @default(0)
  instructions               String?
  drugInteractionCheckPassed Boolean  @default(true)
  allergyCheckPassed         Boolean  @default(true)
  status                     String   @default("ACTIVE")
  issuedAt                   DateTime @default(now())
  pharmacyNotes              String?

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([patientId])
}

model EncounterTemplate {
  id                  String   @id @default(cuid())
  name                String
  specialty           String?
  defaultNoteJson     String
  defaultCptCodesJson String   @default("[]")
  createdBy           String
  isShared            Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model FeeSchedule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  linesJson     String   @default("[]")
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id              String    @id @default(cuid())
  number          String    @unique
  patientId       String
  encounterId     String?   @unique
  providerId      String
  feeScheduleId   String?
  linesJson       String    @default("[]")
  adjustmentsJson String    @default("[]")
  serviceDate     DateTime
  issuedAt        DateTime?
  dueDate         DateTime?
  voidedAt        DateTime?
  voidReason      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  allocations PaymentAllocation[]
  claims      InsuranceClaim[]

  @@index([patientId])
  @@index([issuedAt])
}

model Payment {
  id              String    @id @default(cuid())
  patientId       String
  amountCents     Int
  method          String
  referenceNumber String?
  checkNumber     String?
  processedBy     String
  processedAt     DateTime  @default(now())
  receiptSentTo   String?
  voidedAt        DateTime?
  voidReason      String?

  allocations PaymentAllocation[]

  @@index([patientId])
  @@index([processedAt])
}

model PaymentAllocation {
  id          String @id @default(cuid())
  paymentId   String
  invoiceId   String
  amountCents Int

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
}

model InsuranceClaim {
  id                String    @id @default(cuid())
  invoiceId         String
  patientId         String
  insurancePolicyId String
  payerName         String
  policyNumber      String
  billedCents       Int
  status            String    @default("DRAFT")
  submittedAt       DateTime?
  paidAt            DateTime?
  paidAmountCents   Int?
  denialReason      String?
  appealNote        String?
  /// Insurance payment recorded when the claim was marked paid.
  paymentId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

/// Named monotonic counters (e.g. invoice numbers).
model Counter {
  name  String @id
  value Int    @default(0)
}

// ─── Patient portal (PRD §4.8) ───────────────────────────────────────────────

/// Portal login for a patient. Created by a staff invite (INVITED) or by self-registration.
model PatientAccount {
  id                    String    @id @default(cuid())
  patientId             String    @unique
  email                 String    @unique
  passwordHash          String?
  /// INVITED | ACTIVE | DISABLED
  status                String    @default("INVITED")
  inviteCodeHash        String?
  inviteExpiresAt       DateTime?
  invitedBy             String?
  resetTokenHash        String?
  resetExpiresAt        DateTime?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  activatedAt           DateTime?
  /// NotificationPreferences JSON.
  notificationPrefsJson String    @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

/// Secure message thread between a patient and the care team.
model MessageThread {
  id                String    @id @default(cuid())
  patientId         String
  subject           String
  /// GENERAL | APPOINTMENT | BILLING | PRESCRIPTION | RESULTS
  category          String    @default("GENERAL")
  /// OPEN | CLOSED
  status            String    @default("OPEN")
  lastMessageAt     DateTime  @default(now())
  patientLastReadAt DateTime?
  staffLastReadAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages ThreadMessage[]

  @@index([patientId, lastMessageAt])
  @@index([status, lastMessageAt])
}

model ThreadMessage {
  id         String   @id @default(cuid())
  threadId   String
  /// PATIENT | STAFF
  authorType String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model RefillRequest {
  id             String    @id @default(cuid())
  patientId      String
  prescriptionId String
  pharmacy       String?
  note           String?
  /// PENDING | APPROVED | DENIED
  status         String    @default("PENDING")
  responseNote   String?
  respondedBy    String?
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([patientId])
  @@index([status, createdAt])
}

/// Demographic/contact/insurance changes submitted from the portal for staff review.
model ProfileChangeRequest {
  id              String    @id @default(cuid())
  patientId       String
  /// Record<field, { old, new }>
  changesJson     String
  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING")
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())

  @@index([patientId])
  @@index([status, createdAt])
}

/// Tokenized card on file. Card numbers are never stored.
model SavedPaymentMethod {
  id             String   @id @default(cuid())
  patientId      String
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  cardholderName String
  gatewayToken   String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([patientId])
}