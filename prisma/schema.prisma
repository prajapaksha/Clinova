generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Patient {
  id            String    @id @default(cuid())
  mrn           String    @unique
  title         String?
  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  dateOfBirth   DateTime
  sex           String
  genderIdentity String?
  pronouns      String?
  photoUrl      String?

  contactJson            String
  emergencyContactsJson  String   @default("[]")

  bloodType              String   @default("UNKNOWN")
  heightCm               Float?
  weightKg               Float?
  allergiesJson          String   @default("[]")
  chronicConditionsJson  String   @default("[]")
  currentMedicationsJson String   @default("[]")
  pastSurgeriesJson      String   @default("[]")
  familyHistoryJson      String   @default("[]")
  immunizationLogJson    String   @default("[]")

  insurancePoliciesJson  String   @default("[]")
  documentsJson          String   @default("[]")
  alertsJson             String   @default("[]")
  consentJson            String

  maritalStatus     String?
  occupation        String?
  preferredLanguage String    @default("English")
  ethnicity         String?

  isVip      Boolean   @default(false)
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([lastName])
  @@index([isArchived])
}

model Staff {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String   @default("STAFF")
  isActive     Boolean  @default(true)

  // Profile (PRD §4.3)
  title         String?
  suffix        String?
  phone         String?
  officeLocation String?
  npi           String?
  specialtiesJson String  @default("[]")
  bio           String?
  /// Weekly working-hours template (DaySchedule[]).
  scheduleJson  String   @default("[]")

  // Account security (PRD §5.1)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime  @default(now())
  mfaEnabled          Boolean   @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credentials StaffCredential[]

  @@index([email])
}

model StaffCredential {
  id               String    @id @default(cuid())
  staffId          String
  type             String
  number           String
  issuingState     String?
  issuingAuthority String?
  issueDate        DateTime?
  expirationDate   DateTime?
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expirationDate])
}

/// Append-only record of PHI access and security events (PRD §5.1).
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  userName     String?
  userRole     String?
  action       String
  resourceType String
  resourceId   String?
  patientId    String?
  fieldName    String?
  oldValue     String?
  newValue     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model AppointmentType {
  id                     String        @id @default(cuid())
  name                   String
  defaultDurationMinutes Int           @default(30)
  bufferAfterMinutes     Int           @default(0)
  color                  String        @default("#1976D2")
  /// Fee-schedule code billed for this visit type when the encounter has no service codes.
  defaultServiceCode     String?
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  appointments           Appointment[]
}

model Appointment {
  id                 String    @id @default(cuid())
  patientId          String
  providerId         String
  locationId         String    @default("main")
  appointmentTypeId  String
  slotStart          DateTime
  slotEnd            DateTime
  status             String    @default("SCHEDULED")
  reasonForVisit     String?
  notes              String?
  cancellationReason String?
  cancellationNote   String?
  recurringSeriesId  String?
  rescheduledFromId  String?
  rescheduledToId    String?
  checkedInAt        DateTime?
  completedAt        DateTime?
  remindersJson      String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id])

  @@index([patientId])
  @@index([providerId])
  @@index([slotStart])
  @@index([status])
}

model Encounter {
  id               String    @id @default(cuid())
  patientId        String
  providerId       String
  appointmentId    String?   @unique
  templateId       String?
  status           String    @default("IN_PROGRESS")
  vitalsJson       String    @default("[]")
  noteJson         String
  serviceCodesJson String    @default("[]")
  addendaJson      String    @default("[]")
  signedBy         String?
  signedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  prescriptions Prescription[]

  @@index([patientId])
  @@index([providerId])
  @@index([status])
}

model Prescription {
  id                         String   @id @default(cuid())
  encounterId                String
  patientId                  String
  prescriberId               String
  drugJson                   String
  refillsAllowed             Int      @default(0)
  refillsRemaining           Int      @default(0)
  instructions               String?
  drugInteractionCheckPassed Boolean  @default(true)
  allergyCheckPassed         Boolean  @default(true)
  status                     String   @default("ACTIVE")
  issuedAt                   DateTime @default(now())
  pharmacyNotes              String?

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([patientId])
}

model EncounterTemplate {
  id                  String   @id @default(cuid())
  name                String
  specialty           String?
  defaultNoteJson     String
  defaultCptCodesJson String   @default("[]")
  createdBy           String
  isShared            Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model FeeSchedule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  linesJson     String   @default("[]")
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id              String    @id @default(cuid())
  number          String    @unique
  patientId       String
  encounterId     String?   @unique
  providerId      String
  feeScheduleId   String?
  linesJson       String    @default("[]")
  adjustmentsJson String    @default("[]")
  serviceDate     DateTime
  issuedAt        DateTime?
  dueDate         DateTime?
  voidedAt        DateTime?
  voidReason      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  allocations PaymentAllocation[]
  claims      InsuranceClaim[]

  @@index([patientId])
  @@index([issuedAt])
}

model Payment {
  id              String    @id @default(cuid())
  patientId       String
  amountCents     Int
  method          String
  referenceNumber String?
  checkNumber     String?
  processedBy     String
  processedAt     DateTime  @default(now())
  receiptSentTo   String?
  voidedAt        DateTime?
  voidReason      String?

  allocations PaymentAllocation[]

  @@index([patientId])
  @@index([processedAt])
}

model PaymentAllocation {
  id          String @id @default(cuid())
  paymentId   String
  invoiceId   String
  amountCents Int

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
}

model InsuranceClaim {
  id                String    @id @default(cuid())
  invoiceId         String
  patientId         String
  insurancePolicyId String
  payerName         String
  policyNumber      String
  billedCents       Int
  status            String    @default("DRAFT")
  submittedAt       DateTime?
  paidAt            DateTime?
  paidAmountCents   Int?
  denialReason      String?
  appealNote        String?
  /// Insurance payment recorded when the claim was marked paid.
  paymentId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

/// Named monotonic counters (e.g. invoice numbers).
model Counter {
  name  String @id
  value Int    @default(0)
}
